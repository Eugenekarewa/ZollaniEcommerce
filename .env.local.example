# ── Database (Neon / Supabase / Vercel Postgres) ─────────────────────────────
# Get a free PostgreSQL database at https://neon.tech or https://supabase.com
# After creating the DB, run: npm run db:push
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Resend (email sending) ────────────────────────────────────────────────────
# Create a free account at https://resend.com
# Free tier: 3,000 emails/month
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# The "from" address for outgoing emails.
# Must be a verified domain in Resend (or use onboarding@resend.dev for testing).
RESEND_FROM_EMAIL="Zollani Tech <hello@zollani.co.ke>"

# ── Sanity CMS ────────────────────────────────────────────────────────────────
# Create a free project at https://sanity.io/manage
# Then run the studio with: npx sanity dev (inside the project)
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id_here"
NEXT_PUBLIC_SANITY_DATASET="production"

# Read token — needed for draft previews. Get from sanity.io/manage → API → Tokens
SANITY_API_READ_TOKEN="your_read_token_here"

# ── Claude API (live chat widget) ─────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxx"
