generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String
  message   String
  status    String    @default("new") // new, quoted, closed
  createdAt DateTime  @default(now())
  invoices  Invoice[]

  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model Invoice {
  id                  String             @id @default(cuid())
  invoiceNumber       String             @unique
  contactSubmissionId String?
  contactSubmission   ContactSubmission? @relation(fields: [contactSubmissionId], references: [id])
  clientName          String
  clientEmail         String
  clientPhone         String?
  service             String
  description         String
  amount              Int // KES
  status              String             @default("draft") // draft, sent, paid, cancelled
  paystackRef         String?
  paidAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("invoices")
}
