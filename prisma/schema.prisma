generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String              @id @default(cuid())
  name          String
  email         String              @unique
  phone         String?
  company       String?
  address       String?
  notes         String?
  tags          String[]            @default([])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  submissions   ContactSubmission[]
  invoices      Invoice[]

  @@map("customers")
}

model ContactSubmission {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  service    String
  message    String
  status     String    @default("new") // new, quoted, closed
  createdAt  DateTime  @default(now())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  invoices   Invoice[]

  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model Invoice {
  id                  String             @id @default(cuid())
  invoiceNumber       String             @unique
  contactSubmissionId String?
  contactSubmission   ContactSubmission? @relation(fields: [contactSubmissionId], references: [id])
  customerId          String?
  customer            Customer?          @relation(fields: [customerId], references: [id])
  clientName          String
  clientEmail         String
  clientPhone         String?
  service             String
  description         String
  amount              Int // KES
  amountPaid          Int                @default(0) // KES already received — for partial payments
  status              String             @default("draft") // draft, sent, partial, paid, cancelled
  paymentMethod       String?            // paystack, cash, mpesa, bank, other
  dueDate             DateTime?
  reminderStage       Int                @default(0) // 0=none, 1=due-soon sent, 2=overdue sent, 3=final notice sent
  lastReminderAt      DateTime?
  paystackRef         String?
  paidAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("invoices")
}

model InventoryItem {
  id           String              @id @default(cuid())
  name         String
  sku          String?             @unique
  category     String              // Screens, RAM, Batteries, Cables, Storage, Chargers, Other
  quantity     Int                 @default(0)
  reorderLevel Int                 @default(5)
  unitCost     Int?                // KES — what we pay to acquire it
  unitPrice    Int?                // KES — what we charge a client if used in a repair
  supplier     String?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  movements    InventoryMovement[]

  @@map("inventory_items")
}

model InventoryMovement {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String        // restock, used, adjustment
  quantity  Int           // signed delta — positive for restock, negative for used
  note      String?
  createdAt DateTime      @default(now())

  @@map("inventory_movements")
}

model Expense {
  id          String   @id @default(cuid())
  category    String   // Rent, Utilities, Supplies, Salaries, Marketing, Transport, Other
  description String
  amount      Int      // KES
  date        DateTime @default(now())
  vendor      String?
  notes       String?
  createdAt   DateTime @default(now())

  @@map("expenses")
}
